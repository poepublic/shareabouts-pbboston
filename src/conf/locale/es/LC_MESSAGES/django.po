#: src/sa_vote/jstemplates/sa_vote/pages/terms.html:1
msgid ""
"<strong>Carrier liability:</strong> Mobile carriers are not liable for "
"delayed or undelivered messages."
msgstr ""
"<strong>Responsabilidad del operador:</strong> Los operadores de telefonía "
"móvil no son responsables de los mensajes retrasados o no entregados."

#: src/sa_vote/jstemplates/sa_vote/pages/terms.html:2
msgid ""
"<strong>Help instructions:</strong> If you need help, you can email us at "
"pb@boston.gov. <a href=\"mailto:pb@boston.gov\">Send us an email.</a>"
msgstr ""
"<strong>Instrucciones de ayuda:</strong> Si necesita ayuda, puede enviarnos "
"un correo electrónico a pb@boston.gov. <a "
"href=\"mailto:pb@boston.gov\">Envíenos un correo electrónico.</a>"

#: src/sa_vote/jstemplates/sa_vote/pages/terms.html:3
msgid ""
"<strong>Message frequency:</strong> You will get one text message with a "
"verification code each time you request one. We won't send you any more text"
" messages unless you ask for a new code."
msgstr ""
"<strong>Frecuencia de los mensajes:</strong> Recibirás un mensaje de texto "
"con un código de verificación cada vez que lo solicites. No te enviaremos "
"más mensajes a menos que pidas un nuevo código."

#: src/sa_vote/jstemplates/sa_vote/pages/terms.html:4
msgid "<strong>Pricing:</strong> Message and data rates may apply."
msgstr ""
"<strong>Precios:</strong> Pueden aplicarse tarifas de mensajes y datos."

#: src/sa_vote/jstemplates/sa_vote/pages/terms.html:5
