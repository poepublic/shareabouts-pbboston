msgid "I confirm that I meet the requirements"
msgstr "أؤكد أنني أستوفي الشروط"

#: src/sa_vote/jstemplates/sa_vote/pages/auth.html:9
msgid "I have not voted in this year's IIA cycle"
msgstr "لم أدلي بصوتي في دورة IIA لهذا العام"

