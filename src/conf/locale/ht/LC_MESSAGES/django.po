msgid ""
"What was your household income in the past 12 months? Choose\n"
"                    one:"
msgstr ""
"Konbyen revni kay ou te genyen nan 12 dènye mwa yo? Chwazi\n"
" youn:"

#: src/sa_vote/jstemplates/sa_vote/pages/survey.html:45
msgid ""
"Yes, I have participated in the\n"
"                        past"
msgstr ""
"Wi, mwen te patisipe nan\n"
" pase"

